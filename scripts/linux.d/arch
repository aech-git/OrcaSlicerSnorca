#!/bin/bash
# these are the Arch Linux specific build functions
export FOUND_GTK3
FOUND_GTK3=$(pacman -Q gtk3)

# Addtional Dev packages for OrcaSlicer
export REQUIRED_DEV_PACKAGES=(
    cmake
    curl
    dbus
    eglexternalplatform
    extra-cmake-modules
    file
    gettext
    git
    glew
    gstreamer
    gtk3
    libmspack
    libsecret
    # libspnav is optional (only needed for 3Dconnexion / SpaceNavigator devices).
    mesa
    ninja
    openssl
    texinfo
    wayland-protocols
    webkit2gtk-4.1
    wget
)

if [[ -n "$UPDATE_LIB" ]]
then
    echo -n -e "Updating linux ...\n"
    NEEDED_PKGS=()
    for PKG in "${REQUIRED_DEV_PACKAGES[@]}"; do
        # CachyOS can use mesa-git instead of the regular mesa package.
        # Do not pull in stable mesa and replace the active development driver.
        if [[ "${PKG}" == "mesa" ]] && pacman -Q mesa-git > /dev/null 2>&1; then
            continue
        fi
        # pacman -T accepts dependencies provided by alternate packages.
        pacman -T "${PKG}" > /dev/null 2>&1 || NEEDED_PKGS+=("${PKG}")
    done

    if [[ "${#NEEDED_PKGS[*]}" -gt 0 ]]; then
        echo "Missing dependencies: ${NEEDED_PKGS[*]}"
        sudo pacman -S --needed "${NEEDED_PKGS[@]}"
    else
        echo "All required Arch dependencies are already installed."
    fi
    echo -e "done\n"
    exit 0
fi

export FOUND_GTK3_DEV
FOUND_GTK3_DEV=${FOUND_GTK3}
